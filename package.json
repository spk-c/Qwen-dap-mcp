{
  "name": "@slp-dev1/qwen-dap-mcp",
  "version": "0.18.2",
  "description": "Agentic native debugging via DAP→MCP: crashes, hangs, dumps, causal/lifetime tracing, symbols, record/replay, crash families, and evidence-driven verification.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "qwen-dap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "qwen-extension.json",
    "skills",
    "scripts/hol-guard-dap-policy.py"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/index.js",
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs",
    "package:extension": "npm run check:package",
    "check": "npm run build && npm test && npm run check:package",
    "prepublishOnly": "npm run check",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dap",
    "debug-adapter-protocol",
    "debugger",
    "ai-debugger",
    "native-debugging",
    "debugging-agent",
    "codelldb",
    "lldb",
    "gdb",
    "core-dump",
    "minidump",
    "crash-debugging",
    "crash-analysis",
    "hang-debugging",
    "deadlock-debugging",
    "postmortem-debugging",
    "differential-debugging",
    "qwen",
    "qwen-code",
    "qwen-extension",
    "coding-agent",
    "agentic-debugging",
    "hol-guard",
    "agent-security",
    "record-replay",
    "rr",
    "symbol-debugging",
    "use-after-free",
    "runtime-forensics",
    "sarif"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spk-c/Qwen-dap-mcp.git"
  },
  "homepage": "https://github.com/spk-c/Qwen-dap-mcp#readme",
  "bugs": {
    "url": "https://github.com/spk-c/Qwen-dap-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/debugprotocol": "^1.68.0",
    "zod": "^4.5.4"
  }
}

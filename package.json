{
  "name": "@slp-dev1/qwen-dap-mcp",
  "version": "0.19.3",
  "description": "Native C/C++ crash, hang and minidump debugging for Claude Code, Codex, Qwen and other MCP coding agents via DAP, GDB, LLDB and CodeLLDB.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "qwen-dap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "qwen-extension.json",
    "skills",
    "scripts/hol-guard-dap-policy.py"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/index.js",
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs",
    "package:extension": "npm run check:package",
    "check": "npm run build && npm run check:types && npm run check:strict-budget && npm test && npm run check:docs && npm run check:package",
    "prepublishOnly": "npm run check",
    "start": "node dist/index.js",
    "check:docs": "node scripts/check-docs.mjs",
    "check:pack": "node scripts/check-package-tarball.mjs",
    "check:types": "node scripts/check-type-coverage.mjs",
    "check:strict-budget": "node scripts/check-strict-budget.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-exclude=dist/** --test-coverage-lines=38 --test-coverage-functions=42 --test-coverage-branches=74",
    "bench:transport": "node benchmark/dap-transport.mjs",
    "test:clients": "node --test test/mcp-client-compat.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dap",
    "debug-adapter-protocol",
    "debugger",
    "ai-debugger",
    "native-debugging",
    "debugging-agent",
    "codelldb",
    "lldb",
    "gdb",
    "core-dump",
    "minidump",
    "crash-debugging",
    "crash-analysis",
    "hang-debugging",
    "deadlock-debugging",
    "postmortem-debugging",
    "differential-debugging",
    "qwen",
    "qwen-code",
    "qwen-extension",
    "coding-agent",
    "agentic-debugging",
    "hol-guard",
    "agent-security",
    "record-replay",
    "rr",
    "symbol-debugging",
    "use-after-free",
    "runtime-forensics",
    "sarif",
    "mcp-server",
    "c++-debugging",
    "windows-minidump",
    "claude-code",
    "openai-codex",
    "codex-cli",
    "gemini-cli",
    "cursor",
    "github-copilot"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spk-c/Qwen-dap-mcp.git"
  },
  "homepage": "https://github.com/spk-c/Qwen-dap-mcp#readme",
  "bugs": {
    "url": "https://github.com/spk-c/Qwen-dap-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/debugprotocol": "^1.68.0",
    "zod": "^4.5.4"
  },
  "private": false,
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6"
  },
  "mcpName": "io.github.spk-c/qwen-dap-mcp"
}
